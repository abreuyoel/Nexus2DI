+                    "sku": p.get("sku"),
+                    "nombre": p.get("nombre"),
+                    "fabricante": p.get("fabricante"),
+                    "categoria_id": cat.get("id_categoria"),
+                    "categoria_nombre": cat.get("nombre"),
+                    "precio_base_bs": p.get("precio_base_bs"),
+                    "precio_base_ds": p.get("precio_base_ds"),
+                })
+
+        return {
