+        rutas_activadas_ids = {a.ruta_id for a in activaciones_hoy if a.ruta_id and a.estado == "activo"}
+        rutas_finalizadas_ids = {a.ruta_id for a in activaciones_hoy if a.ruta_id and a.estado == "Finalizado"}
